
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
}

enum JobStatus {
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum EmployerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)

  studentProfile  StudentProfile?
  employerProfile EmployerProfile?

  jobs         Job[]
  applications Application[]
  savedJobs    SavedJob[]
  reports      ReportedJob[] @relation("ReportAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  department String?
  level      String?
  skills     String[] @default([])
  cvUrl      String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployerProfile {
  id               Int                      @id @default(autoincrement())
  userId           Int                      @unique
  organizationName String
  description      String?
  website          String?
  phone            String?
  verificationStatus EmployerVerificationStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             Int            @id @default(autoincrement())
  employerId     Int
  title          String
  description    String
  category       String
  location       String
  employmentType EmploymentType @default(PART_TIME)
  compensation   String?
  deadline       DateTime?
  status         JobStatus      @default(OPEN)

  employer     User          @relation(fields: [employerId], references: [id], onDelete: Restrict)
  applications Application[]
  savedBy      SavedJob[]
  reports      ReportedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([employerId, createdAt])
  @@index([category, status])
}

model Application {
  id           Int               @id @default(autoincrement())
  studentId    Int
  jobId        Int
  coverMessage String?
  status       ApplicationStatus @default(PENDING)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  job     Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, jobId])
  @@index([studentId, appliedAt])
  @@index([jobId, appliedAt])
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  studentId Int
  jobId     Int
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  job     Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([studentId, jobId])
  @@index([studentId, createdAt])
}

model ReportedJob {
  id          Int          @id @default(autoincrement())
  jobId       Int
  reporterId  Int
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  job      Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  reporter User @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([jobId])
  @@index([reporterId])
}
